# Enable VIA support
VIA_ENABLE = yes

# Disable features to save space (VIA takes up a lot of firmware space)
CONSOLE_ENABLE = no        # Console for debug
COMMAND_ENABLE = no        # Commands for debug and configuration
NKRO_ENABLE = yes          # USB Nkey Rollover
# BACKLIGHT_ENABLE = no      # Enable keyboard backlight functionality
# RGBLIGHT_ENABLE = yes      # Enable keyboard RGB underglow
LTO_ENABLE = yes           # Link Time Optimization, reduces firmware size
# Enable RGB Matrix (this is what you need!)
RGB_MATRIX_ENABLE = yes
# If you're using RGB Matrix instead of RGB Light
# RGB_MATRIX_ENABLE = no
